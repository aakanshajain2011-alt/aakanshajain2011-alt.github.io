@article{jain2025india,
  type={3. Working Papers},
  title={College Wage Premiums in India: Trends and Spatial Decomposition, 1987-2012},
  author={Jain, Aakansha},
  journal={},
  year={2025},
  pdf={jain_india_college.pdf},
  abstract={This paper traces the college-versus-high-school earnings gap in India across five waves of the National Sample Survey, 1987-2012, a period when tertiary enrollment nearly tripled. I estimate Mincer wage equations and two-part Cragg models that separate labor-force participation from pay, organized into synthetic birth cohorts. The college premium rose substantially throughout the period for both younger and older workers. Zone-level decompositions, motivated by imperfect substitution between young and old workers, show that the young-old premium gap closed where college supply expanded most and persisted where it did not.}
}

@article{jain_farming,
  type={3. Working Papers},
  title={Returns to Farming with Controls for Farming Entry (under review)},
  author={Cho, Insoo and Jain, Aakansha and Orazem, Peter F.},
  year={2026},
  html={https://dr.lib.iastate.edu/entities/publication/4c032606-9f09-46fc-bf23-0b590eb16241},
  abstract={This study examines entry into farming and the relationship between farming and household income among college graduates using two surveys of Iowa State University alumni. We obtain similar estimates of the returns to farming relative to nonfarm alternatives using propensity-score matching and controls for endogenous treatment effects. Parental farming, early experience working in a family business, and graduating in a weaker nonfarm labor-market are associated with a higher probability of entering farming. Farmers have substantially lower household income than comparable nonfarm graduates, with estimated disadvantages ranging from 33 to 38 percent across matching estimators and approximately 35 percent in the endogenous treatment effects model. In the baseline analysis, the disadvantage is larger and statistically significant among nonrural farmers but smaller and not statistically significant among rural farmers. An illustrative comparison suggests that historical farmland appreciation could generate capital gains comparable to the estimated annual income disadvantage for farmers with sufficient landholdings. These findings suggest that current household income may understate the broader economic returns to farming.}
}

@article{andrade2025alumni,
  type={3. Working Papers},
  title={An Overview of the 2024 Iowa State University Alumni Survey},
  author={Andrade, A. and Eyles, J. and Jain, Aakansha and Kimle, K. and Orazem, Peter F. and Unal, R.},
  journal={ISU Department of Economics Working Paper 25007},
  year={2025},
