@article{jain2026h2a,
  abbr={JMP},
  type={1. Job Market Paper},
  title={The Rise of H-2A: Causal Evidence on Guestworker Substitution for Settled Farm Labor},
  author={Jain, Aakansha},
  journal={},
  year={2026},
  pdf={jain_h2a_jmp.pdf},
  selected={true},
  abstract={The H-2A agricultural guestworker visa program, which enables U.S. farmers to legally hire foreign labor for seasonal farm jobs, grew more than fourfold between 2008 and 2024. Simultaneously, the settled non-citizen workforce that had long supplied the same seasonal farm labor shrank under intensified immigration enforcement. Two thirds of these settled non-citizen agricultural workers in the U.S. lack work authorization. This paper asks whether the decline in settled farm workers caused the rise of the H-2A visa program, and at what rate. Using a panel of 740 commuting zones, I instrument the contemporaneous settled non-citizen share of agricultural labor with its 2000 baseline share interacted with national enforcement shifts. I find that farms hire about one H-2A guestworker for each settled non-citizen worker lost in headcount, replacing roughly three quarters of the lost labor time. Substitution for lost settled workers accounts for about 29 percent of aggregate H-2A growth over the period.}
}

