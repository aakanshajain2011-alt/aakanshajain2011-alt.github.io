@incollection{jain2026youth,
  type={2. Publications},
  title={Youth Labor Markets in High- and Low-Income Countries},
  author={Jain, Aakansha and Montenegro, Claudio and Orazem, Peter F.},
  booktitle={The Oxford Handbook of the 21st Century Economy and Society (forthcoming)},
  editor={Leicht, K.},
  publisher={Oxford University Press},
  year={2026},
  abstract={Uses a new World Bank database covering 160 countries over three decades to compare how youth in high- and low-income economies divide their time among work, schooling, and neither, and how labor market flexibility, human capital, and the level of economic development shape the transition from school to work.}
}

@article{jain2025india,
  type={3. Working Papers},
  title={College Wage Premiums in India: Trends and Spatial Decomposition, 1987-2012},
  author={Jain, Aakansha},
  journal={},
  year={2025},
  pdf={jain_india_college.pdf},
  abstract={This paper traces the college-versus-high-school earnings gap in India across five waves of the National Sample Survey, 1987-2012, a period when tertiary enrollment nearly tripled. I estimate Mincer wage equations and two-part Cragg models that separate labor-force participation from pay, organized into synthetic birth cohorts. The college premium rose substantially throughout the period for both younger and older workers. Zone-level decompositions, motivated by imperfect substitution between young and old workers, show that the young-old premium gap closed where college supply expanded most and persisted where it did not.}
}

@article{andrade2025alumni,
  type={3. Working Papers},
  title={An Overview of the 2024 Iowa State University Alumni Survey},
  author={Andrade, A. and Eyles, J. and Jain, Aakansha and Kimle, K. and Orazem, Peter F. and Unal, R.},
  journal={ISU Department of Economics Working Paper 25007},
  year={2025},
  html={https://econpapers.repec.org/paper/isugenstf/202509021854400000.htm},
  abstract={Documents the design, sample construction, and descriptive findings of the 2024 Iowa State University alumni survey, a follow-up to the 2008 survey (Jolly, Yu, and Orazem 2009). Covers cohorts graduating from 1982 to 2023, with over 5,000 usable Bachelor's-degree responses. Reports patterns of entrepreneurship, employment, education, and geographic mobility across 41 years of ISU graduates.}
}

@article{jain_broadband,
  type={4. Works in Progress},
  title={Does Broadband Close the Rural Education Gap?},
  author={Jain, Aakansha and Han, Luyi and Winters, John V.},
  year={2026},
  abstract={Asks whether federally subsidized broadband raises college enrollment among rural high-school graduates. The Connect America Fund Phase II set block eligibility ex ante through an FCC cost model and deployed in stages over 2015-2021, leaving nearly half of eligible blocks unserved as controls. A staggered difference-in-differences design with block and cohort fixed effects links deployment records to restricted American Community Survey microdata, accessed through the Iowa State Federal Statistical Research Data Center (Project 3044).}
}

@article{jain_farming,
  type={4. Works in Progress},
  title={Returns to Farming Among Iowa State Alumni},
  author={Cho, Insoo and Jain, Aakansha and Orazem, Peter F.},
  year={2026},
  abstract={Compares the household income of farmers and observationally similar nonfarm workers among Iowa State University graduates, using matching estimators and an endogenous treatment effects model. Farmers earn significantly less, even though household income includes off-farm earnings. Among all farmers the gap is concentrated in nonrural households; among full-time farmers it holds in rural areas as well. Entry into farming is driven mainly by family farming background.}
}

@article{jain_entrepreneurship,
  type={4. Works in Progress},
  title={Firm Entry and Serial Entrepreneurship Among Iowa State Alumni},
  author={Jain, Aakansha and Lin, Daniel and Orazem, Peter F.},
  year={2026},
  abstract={Examines how labor market conditions at graduation shape entrepreneurial entry among Iowa State University alumni across the 2008 and 2024 alumni surveys. About 20 percent of graduates start a for-profit business, and one in four of those start more than one. A higher Iowa unemployment rate at graduation delays business entry for about a decade, after which the effect fades; national conditions show no such effect. Over a full career, family and social ties to business ownership predict who becomes an entrepreneur.}
}

