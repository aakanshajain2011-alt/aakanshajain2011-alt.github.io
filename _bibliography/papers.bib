  abstract={Documents the design, sample construction, and descriptive findings of the 2024 Iowa State University alumni survey, a follow-up to the 2008 survey (Jolly, Yu, and Orazem 2009). Covers cohorts graduating from 1982 to 2023, with over 5,000 usable Bachelor's-degree responses. Reports patterns of entrepreneurship, employment, education, and geographic mobility across 41 years of ISU graduates.}
}

@article{jain_broadband,
  type={4. Works in Progress},
  title={Does Broadband Close the Rural Education Gap?},
  author={Jain, Aakansha and Han, Luyi and Winters, John V.},
  year={2026},
  abstract={Asks whether federally subsidized broadband raises college enrollment among rural high-school graduates. The Connect America Fund Phase II set block eligibility ex ante through an FCC cost model and deployed in stages over 2015-2021, leaving nearly half of eligible blocks unserved as controls. A staggered difference-in-differences design with block and cohort fixed effects links deployment records to restricted American Community Survey microdata, accessed through the Iowa State Federal Statistical Research Data Center (Project 3044).}
}


@article{jain_entrepreneurship,
  type={4. Works in Progress},
  title={Firm Entry and Serial Entrepreneurship Among Iowa State Alumni},
  author={Jain, Aakansha and Lin, Daniel and Orazem, Peter F.},
  year={2026},
  abstract={Examines how labor market conditions at graduation shape entrepreneurial entry among Iowa State University alumni across the 2008 and 2024 alumni surveys. About 20 percent of graduates start a for-profit business, and one in four of those start more than one. A higher Iowa unemployment rate at graduation delays business entry for about a decade, after which the effect fades; national conditions show no such effect. Over a full career, family and social ties to business ownership predict who becomes an entrepreneur.}
}

